{
  "schemaVersion": 1,
  "entry": "index.mjs",
  "manifest": {
    "id": "weave-web",
    "name": "Weave 联网",
    "version": "0.1.0",
    "apiVersion": "1.0.0",
    "description": "经共享审批搜索公开网页并读取有来源的有限文本。",
    "host": "in-process",
    "capabilities": ["tool"],
    "contributes": {
      "tools": ["web_search", "web_fetch"]
    },
    "permissions": ["network:request"]
  }
}
