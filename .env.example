# Copy this file to .env and replace the placeholder with your local key.
# The key is read by the Server process only and is never sent to Studio.
WEAVE_LLM_PROVIDERS=[{"id":"deepseek","label":"DeepSeek","type":"openai-compatible","baseUrl":"https://api.deepseek.com","apiKey":"replace-with-your-deepseek-api-key","defaultModel":"deepseek-flash"}]

# Optional: model steps the Agent may take in one turn (1-1000, default 50).
# WEAVE_AGENT_MAX_STEPS=50

# Optional: absolute path to an operator index, alongside the default and user-added sources.
# Restart Server after editing this local file. Remote sources are managed in Studio.
# WEAVE_PLUGIN_MARKETPLACE_CATALOG=/absolute/path/plugin-catalog.json

# Optional: absolute user Skills directory (default <data directory>/skills).
# Project Skills also load from .weave/skills and .agents/skills inside its bound root.
# WEAVE_SKILLS_DIR=/absolute/path/skills
