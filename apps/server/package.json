{
  "name": "@weave/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --root ../.. --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@weave/llm": "workspace:*",
    "@weave/protocol": "workspace:*",
    "@weave/session": "workspace:*",
    "@weave/runtime": "workspace:*",
    "@hono/node-server": "2.1.8",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  }
}
