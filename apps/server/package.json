{
  "name": "@weave/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @weave/server... build && node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/server/test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "marketplace": "node dist/marketplace-cli.js"
  },
  "dependencies": {
    "@weave/llm": "workspace:*",
    "@weave/mcp-client": "workspace:*",
    "@weave/plugin": "workspace:*",
    "@weave/plugin-builtins": "workspace:*",
    "@weave/plugin-host": "workspace:*",
    "@weave/protocol": "workspace:*",
    "@weave/session": "workspace:*",
    "@weave/runtime": "workspace:*",
    "@weave/workspace": "workspace:*",
    "@hono/node-server": "2.1.8",
    "hono": "4.13.18",
    "zod": "4.6.7",
    "@weave/memory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  }
}
