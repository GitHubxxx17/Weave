{
  "name": "weave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "patchedDependencies": {
      "@modelcontextprotocol/client@2.4.0": "patches/@modelcontextprotocol__client@2.4.0.patch"
    }
  },
  "engines": {
    "node": ">=24.4.0",
    "pnpm": ">=10.13.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --parallel --filter @weave/server --filter @weave/studio dev",
    "desktop:dev": "pnpm --filter @weave/desktop run rebuild && pnpm --filter @weave/desktop... build && node apps/desktop/dist/dev.js",
    "desktop:rebuild": "pnpm --filter @weave/desktop run rebuild",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "marketplace:generate": "pnpm --filter @weave/server... build && node apps/server/dist/marketplace-cli.js generate",
    "marketplace:check": "pnpm --filter @weave/server... build && node apps/server/dist/marketplace-cli.js check",
    "marketplace:entry": "pnpm --filter @weave/server... build && node apps/server/dist/marketplace-cli.js entry"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.0.15"
  }
}
